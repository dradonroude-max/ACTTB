---
/**
 * =========================================================
 * ACTT — HOME PAGE
 * =========================================================
 */

import PageLayout from "../layouts/PageLayout.astro";

import VisionOSHero from "../components/VisionOSHero.astro";
import VisionOSSection from "../components/VisionOSSection.astro";
import VisionOSPanel from "../components/VisionOSPanel.astro";
import VisionOSCard from "../components/VisionOSCard.astro";
import VisionOSButton from "../components/VisionOSButton.astro";
import VisionOSBadge from "../components/VisionOSBadge.astro";
import VisionOSTeamCard from "../components/VisionOSTeamCard.astro";

import { club } from "../data/club";
import { teams } from "../data/teams";
import { partners } from "../data/partners";
import { pricing } from "../data/pricing";
import { upcomingMatches, recentResults } from "../data/calendar";
import { site } from "../config/site";
---

<PageLayout
  title="ACTT — Camphin-en-Carembault Tennis de Table"
  description="Camphin-en-Carembault Tennis de Table — un club de tennis de table ouvert à tous, du loisir à la compétition."
>

  <!-- HERO -->
  <VisionOSHero
    eyebrow="CAMPHIN-EN-CAREMBAULT"
    title="UN CLUB. UNE ÉQUIPE. UNE PASSION."
    description={club.description}
    primaryCtaLabel="Jouer à l’ACTT"
    primaryCtaHref="#jouer"
    secondaryCtaLabel="Première séance"
    secondaryCtaHref="#essayer"
    badge="Tennis de table"
    image={site.assets.logo}
    imageAlt="ACTT — Camphin-en-Carembault Tennis de Table"
  />


  <!-- LE CLUB -->
  <VisionOSSection
    id="club"
    eyebrow="LE CLUB"
    title="Camphin-en-Carembault Tennis de Table"
    description="Un club de tennis de table à Camphin-en-Carembault, dans un esprit ouvert et collectif."
    spacing="sm"
  >
    <div class="vision-grid-2 club-panels">

      <VisionOSPanel depth="raised" padding="lg" class="club-panel club-panel-primary">
        <VisionOSBadge label="ACTT" variant="primary" />
        <h3>{club.tagline}</h3>
        <p>{club.description}</p>
      </VisionOSPanel>

      <VisionOSPanel depth="floating" padding="lg" class="club-panel club-panel-secondary">
        <VisionOSBadge label="Le club" variant="success" />
        <h3>Tennis de table à {club.city}</h3>
        <p>
          Retrouvez ici les informations essentielles pour découvrir
          le club, comprendre son fonctionnement et nous contacter.
        </p>
        <VisionOSButton label="Découvrir le club" href="#essayer" variant="outline" />
      </VisionOSPanel>

    </div>
  </VisionOSSection>


  <!-- JOUER -->
  <VisionOSSection
    id="jouer"
    eyebrow="JOUER"
    title="Jouer à l’ACTT"
    description="Les différentes pratiques du club seront présentées ici."
    spacing="sm"
  >
    <div class="vision-grid-3">
      <VisionOSCard title="Jeunes" description="Les informations relatives aux pratiques proposées par le club seront bientôt disponibles." badge="À venir" variant="glass" />
      <VisionOSCard title="Loisir" description="Cette rubrique accueillera les informations concernant la pratique loisir." badge="À venir" />
      <VisionOSCard title="Compétition" description="Cette rubrique accueillera les informations concernant la pratique en compétition." badge="À venir" />
    </div>
  </VisionOSSection>


  <!-- ÉQUIPES -->
  <VisionOSSection
    id="equipes"
    eyebrow="ÉQUIPES"
    title="Les équipes de l’ACTT"
    description="Découvrez les équipes du club et leurs joueurs."
    spacing="sm"
  >
    <div class="vision-grid-2 equipes-grid">
      {teams.map((team) => (<VisionOSTeamCard team={team} />))}
    </div>
  </VisionOSSection>


  <!-- ACTUALITÉS -->
  <VisionOSSection
    id="actualites"
    eyebrow="ACTUALITÉS"
    title="Les actualités du club"
    description="Les dernières informations concernant la vie de l’ACTT seront publiées ici."
    spacing="sm"
  >
    <div class="vision-grid-3">
      <VisionOSCard title="Actualités" description="Les actualités du club seront publiées dans cette rubrique." badge="À venir" variant="glass" />
    </div>
  </VisionOSSection>


  <!-- CALENDRIER ET RÉSULTATS -->
  <VisionOSSection
    id="calendrier"
    eyebrow="CALENDRIER"
    title="Calendrier et résultats"
    description="Les prochains rendez-vous et les derniers résultats du club."
    spacing="sm"
  >
    <div class="calendrier-grid">

      {recentResults.length > 0 && (
        <article class="calendrier-card calendrier-card-results">
          <span class="calendrier-card-accent" aria-hidden="true"></span>
          <header class="calendrier-card-header">
            <span class="calendrier-card-eyebrow">Résultats</span>
            <h3 class="calendrier-card-title">Derniers matchs</h3>
          </header>
          <ul class="calendar-list">
            {recentResults.map((result) => (
              <li class="calendar-item">
                <div class="calendar-item-main">
                  <span class="calendar-item-team">{result.team}</span>
                  <span class="calendar-item-vs">vs</span>
                  <span class="calendar-item-opponent">{result.opponent}</span>
                </div>
                <div class="calendar-item-meta">
                  <span class="calendar-item-date">{result.date}</span>
                  <span class:list={["calendar-result-badge", `calendar-result-badge-${result.outcome}`]}>
                    {result.score}
                  </span>
                </div>
              </li>
            ))}
          </ul>
        </article>
      )}

      {upcomingMatches.length > 0 && (
        <article class="calendrier-card calendrier-card-upcoming">
          <span class="calendrier-card-accent" aria-hidden="true"></span>
          <header class="calendrier-card-header">
            <span class="calendrier-card-eyebrow">À venir</span>
            <h3 class="calendrier-card-title">Prochains matchs</h3>
          </header>
          <ul class="calendar-list">
            {upcomingMatches.map((match) => (
              <li class="calendar-item">
                <div class="calendar-item-main">
                  <span class="calendar-item-team">{match.team}</span>
                  <span class="calendar-item-vs">vs</span>
                  <span class="calendar-item-opponent">{match.opponent}</span>
                </div>
                <div class="calendar-item-meta">
                  <span class="calendar-item-date">{match.date} · {match.time}</span>
                  <span class:list={["calendar-item-location", match.location === "domicile" ? "calendar-item-location-home" : "calendar-item-location-away"]}>
                    {match.location}
                  </span>
                </div>
              </li>
            ))}
          </ul>
        </article>
      )}

    </div>
  </VisionOSSection>


  <!-- PARTENAIRES -->
  <VisionOSSection
    id="partenaires"
    eyebrow="PARTENAIRES"
    title="Nos partenaires"
    description="Les partenaires qui accompagnent l’ACTT."
    align="center"
    spacing="sm"
  >
    {partners.length > 0 ? (
      <ul class="vision-partners-grid">
        {partners.map((partner) => (
          <li class="vision-partner-item">
            {partner.href ? (
              <a class="vision-partner-card vision-partner-card-link" href={partner.href} target="_blank" rel="noopener noreferrer" aria-label={partner.name}>
                <span class="vision-partner-logo"><img src={partner.logo} alt="" loading="lazy" decoding="async" /></span>
                {partner.description ? (<span class="vision-partner-description">{partner.description}</span>) : (<span class="vision-partner-name">{partner.name}</span>)}
              </a>
            ) : (
              <div class="vision-partner-card">
                <span class="vision-partner-logo"><img src={partner.logo} alt={partner.name} loading="lazy" decoding="async" /></span>
                {partner.description ? (<span class="vision-partner-description">{partner.description}</span>) : (<span class="vision-partner-name">{partner.name}</span>)}
              </div>
            )}
          </li>
        ))}
      </ul>
    ) : (
      <div class="vision-grid-3">
        <VisionOSCard title="Partenaires" description="Cette rubrique accueillera les partenaires du club." badge="À venir" variant="glass" />
      </div>
    )}
  </VisionOSSection>


  <!-- TARIFS -->
  <VisionOSSection
    id="tarifs"
    eyebrow="TARIFS"
    title="Les tarifs de l’ACTT"
    description="Deux formules simples, pour les enfants et les adultes."
    align="center"
    spacing="sm"
  >
    <ul class="vision-pricing-grid">
      {pricing.map((tier) => (
        <li class="vision-pricing-item">
          <article class="vision-pricing-card">
            <span class="vision-pricing-label">{tier.label}</span>
            <p class="vision-pricing-audience">{tier.audience}</p>
            <p class="vision-pricing-price">{tier.price}</p>
            <p class="vision-pricing-period">par saison</p>
            <p class="vision-pricing-schedule">{tier.schedule}</p>
            {tier.note && (<p class="vision-pricing-note">{tier.note}</p>)}
          </article>
        </li>
      ))}
    </ul>
  </VisionOSSection>


  <!-- INSCRIPTION -->
  <VisionOSSection
    id="inscription"
    eyebrow="INSCRIPTION"
    title="S’inscrire à l’ACTT"
    description="Téléchargez la fiche, remplissez-la et renvoyez-la au club."
    align="center"
    spacing="sm"
  >

    <!-- 3 ÉTAPES -->
    <div class="inscription-steps">

      <div class="inscription-step">
        <span class="inscription-step-number">1</span>
        <h3 class="inscription-step-title">Télécharger la fiche</h3>
        <p class="inscription-step-text">
          La fiche officielle contient toutes les informations
          nécessaires : identité, contact, engagements et
          autorisations.
        </p>
      </div>

      <div class="inscription-step">
        <span class="inscription-step-number">2</span>
        <h3 class="inscription-step-title">Remplir et signer</h3>
        <p class="inscription-step-text">
          Remplissez la fiche, imprimez-la et signez-la.
          La signature manuscrite est obligatoire, y compris
          pour les mineurs (représentant légal).
        </p>
      </div>

      <div class="inscription-step">
        <span class="inscription-step-number">3</span>
        <h3 class="inscription-step-title">Renvoyer au club</h3>
        <p class="inscription-step-text">
          Renvoyez la fiche signée accompagnée de votre
          règlement. L’inscription est effective à réception
          du paiement.
        </p>
      </div>

    </div>

    <!-- PANNEAU FINAL : bouton + infos -->
    <VisionOSPanel
      depth="floating"
      padding="lg"
      class="inscription-panel"
    >
      <div class="inscription-panel-content">

        <!-- Bouton de téléchargement -->
        <a
          class="vision-button vision-button-primary vision-button-lg inscription-download-button"
          href="/documents/fiche_inscription_ACTT_2026-2027.pdf"
          target="_blank"
          rel="noopener noreferrer"
        >
          <span>↓&nbsp;&nbsp;Télécharger la fiche d'inscription 2026-2027</span>
        </a>

        <p class="inscription-download-note">
          Format PDF · à imprimer et signer
        </p>

        <!-- Séparateur visuel -->
        <div class="inscription-separator" aria-hidden="true"></div>

        <!-- Informations pratiques -->
        <div class="inscription-info-grid">

          <div class="inscription-info-item">
            <span class="inscription-info-label">Paiement</span>
            <span class="inscription-info-value">
              Virement bancaire ou chèque à l'ordre de L'ACTT
            </span>
          </div>

          <div class="inscription-info-item">
            <span class="inscription-info-label">Contact</span>
            <span class="inscription-info-value">
              <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
              <span class="inscription-info-sep"> · </span>
              <a href={`tel:${site.contact.phone.replace(/\s+/g, "")}`}>{site.contact.phone}</a>
            </span>
          </div>

        </div>

        <!-- Renvoi vers Première séance -->
        <p class="inscription-hint">
          Nouveau au club ?
          <a href="#essayer">Venez d'abord essayer une séance</a>
        </p>

      </div>
    </VisionOSPanel>

  </VisionOSSection>


  <!-- PREMIÈRE SÉANCE -->
  <VisionOSSection
    id="essayer"
    eyebrow="PREMIÈRE SÉANCE"
    title="Envie d’essayer ?"
    description="Pour découvrir l’ACTT et obtenir les informations nécessaires pour une première séance, contactez-nous."
    align="center"
    spacing="sm"
  >
    <VisionOSPanel depth="floating" padding="lg" class="essayer-panel">
      <div class="vision-contact-content">
        <VisionOSBadge label="ACTT" variant="primary" />
        <h3>Votre première séance commence ici.</h3>
        <p>
          Pour connaître les modalités et préparer votre venue,
          contactez directement le club.
        </p>
        <div class="vision-contact-actions">
          <VisionOSButton
            label="Nous contacter par mail"
            href={`mailto:${site.contact.email}`}
            variant="primary"
            size="lg"
          />
          <VisionOSButton
            label="Appeler"
            href={`tel:${site.contact.phone.replace(/\s+/g, "")}`}
            variant="outline"
            size="lg"
          />
        </div>
      </div>
    </VisionOSPanel>
  </VisionOSSection>


  <div id="contact" aria-hidden="true"></div>

</PageLayout>


<style>

  /* =======================================================
     CENTRAGE DES TITRES DE SECTION
     ======================================================= */

  :global(.vision-section-align-center) :global(.vision-section-title) {
    margin-inline: auto;
  }


  /* =======================================================
     LE CLUB
     ======================================================= */

  :global(.club-panel)::before,
  :global(.club-panel)::after {
    display: none !important;
    content: none !important;
  }

  .club-panel {
    border-top: 1px solid var(--vision-border) !important;
  }

  .club-panel-primary {
    border-top: 1px solid var(--vision-border) !important;
  }


  /* =======================================================
     ÉQUIPES
     ======================================================= */

  .equipes-grid {
    align-items: stretch;
  }


  /* =======================================================
     CALENDRIER ET RÉSULTATS
     ======================================================= */

  .calendrier-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: start;
    gap: 28px;
    max-width: 1100px;
    margin-inline: auto;
  }

  .calendrier-card {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: #ffffff;
    border: 1px solid rgba(6, 26, 58, 0.10);
    border-radius: 16px;
    box-shadow: 0 14px 34px rgba(6, 26, 58, 0.10);
  }

  .calendrier-card-accent {
    display: block;
    width: 100%;
    height: 4px;
    flex: 0 0 4px;
  }

  .calendrier-card-results .calendrier-card-accent {
    background: linear-gradient(90deg, #35a853 0%, #8bcf32 100%);
  }

  .calendrier-card-upcoming .calendrier-card-accent {
    background: linear-gradient(90deg, #00aeef 0%, #073b7a 100%);
  }

  .calendrier-card-header {
    padding: 22px 26px 18px;
    border-bottom: 1px solid rgba(6, 26, 58, 0.08);
  }

  .calendrier-card-eyebrow {
    display: block;
    margin-bottom: 6px;
    color: #45617f;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .calendrier-card-title {
    margin: 0;
    color: #061a3a;
    font-size: 1.3rem;
    font-weight: 800;
    letter-spacing: -0.01em;
  }

  .calendar-list {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .calendar-item {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 16px 26px;
    border-bottom: 1px solid rgba(6, 26, 58, 0.06);
  }

  .calendar-item:last-child {
    border-bottom: none;
  }

  .calendar-item-main {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
    flex: 1 1 auto;
  }

  .calendar-item-team,
  .calendar-item-opponent {
    color: #061a3a;
    font-size: var(--vision-text-md);
    font-weight: 600;
    line-height: 1.3;
  }

  .calendar-item-vs {
    color: #45617f;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .calendar-item-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
  }

  .calendar-item-date {
    color: #45617f;
    font-size: var(--vision-text-sm);
    white-space: nowrap;
  }

  .calendar-item-location {
    display: inline-flex;
    align-items: center;
    padding: 4px 10px;
    border-radius: 999px;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .calendar-item-location-home {
    background: rgba(53, 168, 83, 0.14);
    color: #1f6b35;
  }

  .calendar-item-location-away {
    background: rgba(0, 174, 239, 0.14);
    color: #073b7a;
  }

  .calendar-result-badge {
    display: inline-flex;
    align-items: center;
    padding: 5px 13px;
    border-radius: 999px;
    font-size: var(--vision-text-sm);
    font-weight: 800;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  .calendar-result-badge-victoire {
    background: rgba(53, 168, 83, 0.16);
    color: #1f6b35;
  }

  .calendar-result-badge-defaite {
    background: rgba(143, 21, 32, 0.12);
    color: #8f1520;
  }

  .calendar-result-badge-nul {
    background: rgba(6, 26, 58, 0.10);
    color: #17345c;
  }


  /* =======================================================
     INSCRIPTION — ÉTAPES
     ======================================================= */

  .inscription-steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    max-width: 1000px;
    margin-inline: auto;
    margin-bottom: 40px;
  }

  .inscription-step {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    padding: 32px 22px;
    background: rgba(248, 250, 252, 0.05);
    border: 1px solid rgba(248, 250, 252, 0.10);
    border-radius: 16px;
    text-align: center;
  }

  .inscription-step-number {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: linear-gradient(135deg, #00aeef 0%, #35a853 100%);
    color: #061a3a;
    font-size: 1.4rem;
    font-weight: 900;
    line-height: 1;
    box-shadow: 0 6px 18px rgba(0, 174, 239, 0.28);
  }

  .inscription-step-title {
    margin: 0;
    color: #f8fafc;
    font-size: 1.05rem;
    font-weight: 800;
    line-height: 1.25;
  }

  .inscription-step-text {
    margin: 0;
    color: rgba(248, 250, 252, 0.68);
    font-size: 0.9rem;
    line-height: 1.55;
  }


  /* =======================================================
     INSCRIPTION — PANNEAU FINAL
     ======================================================= */

  .inscription-panel {
    max-width: 720px;
    margin-inline: auto;
  }

  .inscription-panel-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
  }

  .inscription-download-button {
    width: 100%;
    max-width: 500px;
  }

  .inscription-download-note {
    margin: 0;
    color: var(--vision-color-text-muted);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .inscription-separator {
    width: 100%;
    height: 1px;
    background: rgba(6, 26, 58, 0.10);
    margin-block: 4px;
  }

   .inscription-info-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    width: 100%;
    max-width: 640px;
    margin-inline: auto;
  }

  .inscription-info-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    text-align: center;
  }

  .inscription-info-label {
    color: var(--vision-color-secondary);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .inscription-info-value {
    color: var(--vision-color-text);
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .inscription-info-value a {
    color: var(--vision-color-text);
    text-decoration: underline;
    text-decoration-color: rgba(6, 26, 58, 0.25);
    text-underline-offset: 3px;
  }

  .inscription-info-sep {
    color: rgba(6, 26, 58, 0.35);
    margin-inline: 4px;
  }

  .inscription-hint {
    margin: 8px 0 0;
    color: var(--vision-color-text-muted);
    font-size: 0.9rem;
    text-align: center;
  }

  .inscription-hint a {
    color: var(--vision-color-accent);
    font-weight: 700;
    text-decoration: none;
    margin-left: 4px;
  }

  .inscription-hint a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }


  /* =======================================================
     PARTENAIRES
     ======================================================= */

  :global(.vision-section[id="partenaires"]) :global(.vision-section-content) {
    display: flex;
    justify-content: center;
  }

  .vision-partners-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: stretch;
    gap: var(--vision-space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .vision-partner-item {
    display: flex;
    width: 240px;
    max-width: 240px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .vision-partner-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--vision-space-3);
    width: 100%;
    min-height: 200px;
    padding: 28px 24px;
    background: #ffffff;
    border: 1px solid rgba(6, 26, 58, 0.10);
    border-radius: 14px;
    box-shadow: 0 8px 22px rgba(6, 26, 58, 0.06);
    text-decoration: none;
    transition: transform var(--vision-duration-normal) var(--vision-ease-smooth), box-shadow var(--vision-duration-normal) var(--vision-ease-smooth), border-color var(--vision-duration-normal) var(--vision-ease-standard);
  }

  .vision-partner-logo {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 80px;
    overflow: hidden;
  }

  .vision-partner-logo img {
    display: block;
    width: auto;
    height: auto;
    max-width: 160px;
    max-height: 64px;
    object-fit: contain;
  }

  .vision-partner-name {
    color: #061a3a;
