---
/**
 * =========================================================
 * ACTT — HOME PAGE
 * =========================================================
 */

import PageLayout from "../layouts/PageLayout.astro";

import VisionOSHero from "../components/VisionOSHero.astro";
import VisionOSSection from "../components/VisionOSSection.astro";
import VisionOSPanel from "../components/VisionOSPanel.astro";
import VisionOSCard from "../components/VisionOSCard.astro";
import VisionOSButton from "../components/VisionOSButton.astro";
import VisionOSBadge from "../components/VisionOSBadge.astro";
import VisionOSTeamCard from "../components/VisionOSTeamCard.astro";
import VisionOSGallery from "../components/VisionOSGallery.astro";
import VisionOSMap from "../components/VisionOSMap.astro";

import { club } from "../data/club";
import { teams } from "../data/teams";
import { partners } from "../data/partners";
import { pricing } from "../data/pricing";
import { upcomingMatches, recentResults } from "../data/calendar";
import { site } from "../config/site";
---

<PageLayout
  title="ACTT — Camphin-en-Carembault Tennis de Table"
  description="Camphin-en-Carembault Tennis de Table — un club de tennis de table ouvert à tous, du loisir à la compétition."
>

  <!-- HERO -->
  <VisionOSHero
    badge="Tennis de table · Camphin-en-Carembault"
    title="UN CLUB. UNE ÉQUIPE. UNE PASSION."
    description="Jeunes, loisir ou compétition. Mardi et jeudi, salle omnisports."
    highlights={[
      "1ère séance gratuite",
      "Raquettes prêtées",
      "Dès 25 € la saison",
    ]}
    primaryCtaLabel="Venir essayer, c'est gratuit"
    primaryCtaHref="#essayer"
    secondaryCtaLabel="Horaires et tarifs"
    secondaryCtaHref="#tarifs"
    image={site.assets.logo}
    imageAlt="ACTT — Camphin-en-Carembault Tennis de Table"
  />


  <!-- LE CLUB -->
  <VisionOSSection
    id="club"
    eyebrow="LE CLUB"
    title="Camphin-en-Carembault Tennis de Table"
    description="Un club de tennis de table à Camphin-en-Carembault, dans un esprit ouvert et collectif."
    spacing="sm"
  >
    <div class="vision-grid-2 club-panels">

      <VisionOSPanel depth="raised" padding="lg" class="club-panel club-panel-primary">
        <VisionOSBadge label="Notre histoire" variant="primary" />
        <h3>{club.tagline}</h3>
        <p>{club.description}</p>
      </VisionOSPanel>

      <VisionOSPanel depth="floating" padding="lg" class="club-panel club-panel-secondary">
        <VisionOSBadge label="Le club" variant="success" />
        <h3>Tennis de table à {club.city}</h3>
        <p>
          Retrouvez ici les informations essentielles pour découvrir
          le club, comprendre son fonctionnement et nous contacter.
        </p>
        <VisionOSButton label="Découvrir le club" href="#essayer" variant="outline" />
      </VisionOSPanel>

    </div>
  </VisionOSSection>


  <!-- JOUER -->
  <VisionOSSection
    id="jouer"
    eyebrow="JOUER"
    title="Jouer à l’ACTT"
    description="Les différentes pratiques du club seront présentées ici."
    spacing="sm"
  >
    <div class="vision-grid-3">
      <VisionOSCard
        title="Jeunes"
        description="Dès le plus jeune âge, on apprend les bases, on progresse à son rythme et on se fait des copains."
        badge="Dès le plus jeune âge"
        variant="glass"
      />
      <VisionOSCard
        title="Loisir"
        description="Jouer pour le plaisir, sans pression ni classement. À son rythme, quand on veut."
        badge="Pour le plaisir"
      />
      <VisionOSCard
        title="Compétition"
        description="Des équipes engagées en championnat, un esprit collectif, une vraie progression sportive."
        badge="En championnat"
      />
    </div>
  </VisionOSSection>


  <!-- ÉQUIPES -->
  <VisionOSSection
    id="equipes"
    eyebrow="ÉQUIPES"
    title="Les équipes de l’ACTT"
    description="Découvrez les équipes du club et leurs joueurs."
    spacing="sm"
  >
    <div class="vision-grid-2 equipes-grid">
      {teams.map((team) => (<VisionOSTeamCard team={team} />))}
    </div>
  </VisionOSSection>


  <!-- ACTUALITÉS -->
  <VisionOSSection
    id="actualites"
    eyebrow="ACTUALITÉS"
    title="Les actualités du club"
    description="Les dernières informations concernant la vie de l’ACTT seront publiées ici."
    spacing="sm"
  >
    <div class="vision-grid-3">
      <VisionOSCard title="Actualités" description="Les actualités du club seront publiées dans cette rubrique." badge="À venir" variant="glass" />
    </div>
  </VisionOSSection>


  <!-- CALENDRIER ET RÉSULTATS -->
  <VisionOSSection
    id="calendrier"
    eyebrow="CALENDRIER"
    title="Calendrier et résultats"
    description="Les prochains rendez-vous et les derniers résultats du club."
    spacing="sm"
  >
    <div class="calendrier-grid">

      {upcomingMatches.length > 0 && (
        <article class="calendrier-card calendrier-card-upcoming">
          <span class="calendrier-card-accent" aria-hidden="true"></span>

          <header class="calendrier-card-header">
            <span class="calendrier-card-eyebrow">À venir</span>
            <h3 class="calendrier-card-title">Prochains matchs</h3>
          </header>

          <ul class="calendar-list">
            {upcomingMatches.map((match) => (
              <li class="calendar-item">
                <div class="calendar-item-top">
                  <span class="calendar-item-datetime">
                    <time datetime={match.date} class="calendar-item-date">
                      {match.dateLabel}
                    </time>
                    <span class="calendar-item-time">· {match.time}</span>
                  </span>

                  {match.location === "domicile" ? (
                    <a
                      href="#essayer"
                      class="calendar-item-location calendar-item-location-home"
                      title="Voir l'adresse de la salle"
                    >
                      Domicile
                    </a>
                  ) : (
                    <span class="calendar-item-location calendar-item-location-away">
                      À {match.opponentCity ?? "l'extérieur"}
                    </span>
                  )}
                </div>

                <div class="calendar-item-match">
                  <span class="calendar-item-team">{match.team}</span>
                  <span class="calendar-item-vs">—</span>
                  <span class="calendar-item-opponent">{match.opponent}</span>
                </div>

                <span class="calendar-item-division">{match.division}</span>
              </li>
            ))}
          </ul>
        </article>
      )}

      {recentResults.length > 0 && (
        <article class="calendrier-card calendrier-card-results">
          <span class="calendrier-card-accent" aria-hidden="true"></span>

          <header class="calendrier-card-header">
            <span class="calendrier-card-eyebrow">Résultats</span>
            <h3 class="calendrier-card-title">Derniers matchs</h3>
          </header>

          <ul class="calendar-list">
            {recentResults.slice(0, 3).map((result) => (
              <li class="calendar-item calendar-item-result">
                <div class="calendar-item-top">
                  <time datetime={result.date} class="calendar-item-date">
                    {result.dateLabel}
                  </time>

                  <span
                    class:list={[
                      "calendar-result-badge",
                      `calendar-result-badge-${result.outcome}`,
                    ]}
                  >
                    {result.outcome === "victoire"
                      ? "V"
                      : result.outcome === "defaite"
                      ? "D"
                      : "N"}{" "}
                    {result.score}
                  </span>
                </div>

                <div class="calendar-item-match">
                  <span class="calendar-item-team">{result.team}</span>
                  <span class="calendar-item-vs">—</span>
                  <span class="calendar-item-opponent">{result.opponent}</span>
                </div>

                <span class="calendar-item-division">{result.division}</span>
              </li>
            ))}
          </ul>
        </article>
      )}

    </div>
  </VisionOSSection>


  <!-- PARTENAIRES -->
  <VisionOSSection
    id="partenaires"
    eyebrow="PARTENAIRES"
    title="Nos partenaires"
    description="Les partenaires qui accompagnent l’ACTT."
    align="center"
    spacing="sm"
  >
    {partners.length > 0 ? (
      <ul class="vision-partners-grid">
        {partners.map((partner) => (
          <li class="vision-partner-item">
            {partner.href ? (
              <a
                class:list={[
                  "vision-partner-card",
                  "vision-partner-card-link",
                  partner.size === "large" && "vision-partner-card-large",
                ]}
                href={partner.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={partner.name}
              >
                <span class="vision-partner-logo">
                  <img src={partner.logo} alt={partner.name} loading="lazy" decoding="async" />
                </span>
              </a>
            ) : (
              <div
                class:list={[
                  "vision-partner-card",
                  partner.size === "large" && "vision-partner-card-large",
                ]}
              >
                <span class="vision-partner-logo">
                  <img src={partner.logo} alt={partner.name} loading="lazy" decoding="async" />
                </span>
              </div>
            )}
          </li>
        ))}
      </ul>
    ) : (
      <div class="vision-grid-3">
        <VisionOSCard title="Partenaires" description="Cette rubrique accueillera les partenaires du club." badge="À venir" variant="glass" />
      </div>
    )}
  </VisionOSSection>


  <!-- TARIFS -->
  <VisionOSSection
    id="tarifs"
    eyebrow="TARIFS"
    title="Les tarifs de l’ACTT"
    description="Deux formules simples, pour les enfants et les adultes."
    align="center"
    spacing="sm"
  >
    <ul class="vision-pricing-grid">
      {pricing.map((tier) => (
        <li class="vision-pricing-item">
          <article class="vision-pricing-card">
            <span class="vision-pricing-label">{tier.label}</span>
            <p class="vision-pricing-audience">{tier.audience}</p>
            <p class="vision-pricing-price">{tier.price}</p>
            <p class="vision-pricing-period">par saison</p>
            <p class="vision-pricing-schedule">{tier.schedule}</p>
            {tier.note && (<p class="vision-pricing-note">{tier.note}</p>)}
          </article>
        </li>
      ))}
    </ul>
  </VisionOSSection>


  <!-- PREMIÈRE SÉANCE -->
  <VisionOSSection
    id="essayer"
    eyebrow="PREMIÈRE SÉANCE"
    title="Venez sans réserver"
    align="center"
    spacing="sm"
  >

    <div class="essayer-grid">

      <!-- COLONNE GAUCHE — INFORMATIONS -->
      <div class="essayer-info">

        <dl class="essayer-info-list">

          <div class="essayer-info-item">
            <dt class="essayer-info-label">Quand</dt>
            <dd class="essayer-info-value">
              <strong>Mardi et jeudi</strong>
              <span>Enfants 18h–19h</span>
              <span>Adultes 19h–21h</span>
            </dd>
          </div>

          <div class="essayer-info-item">
            <dt class="essayer-info-label">Où</dt>
            <dd class="essayer-info-value">
              <strong>Salle omnisports</strong>
              <span>7 Rue du Joncquoy</span>
              <span>59133 Camphin-en-Carembault</span>
            </dd>
          </div>

          <div class="essayer-info-item">
            <dt class="essayer-info-label">1re séance</dt>
            <dd class="essayer-info-value">
              <strong>Gratuite, sans engagement</strong>
              <span>Raquettes prêtées</span>
            </dd>
          </div>

          <div class="essayer-info-item">
            <dt class="essayer-info-label">À apporter</dt>
            <dd class="essayer-info-value">
              <span>Une tenue de sport</span>
            </dd>
          </div>

        </dl>

      </div>


      <!-- COLONNE DROITE — VISUEL + ACTIONS -->
      <div class="essayer-visual">

        <VisionOSMap
          label="Salle omnisports"
          address="7 Rue du Joncquoy, 59133 Camphin-en-Carembault"
          subtleTrigger={true}
          class="essayer-map"
        />

        <div class="essayer-actions">

          <a
            class="essayer-itinerary"
            href="https://www.google.com/maps/dir/?api=1&destination=7%20Rue%20du%20Joncquoy%2C%2059133%20Camphin-en-Carembault"
            target="_blank"
            rel="noopener noreferrer"
          >
            Itinéraire
          </a>

          <div class="essayer-contact-block">
            <span class="essayer-contact-label">Une question ?</span>

            <a
              class="essayer-contact"
              href={`mailto:${site.contact.email}`}
            >
              {site.contact.email}
            </a>

            <a
              class="essayer-contact"
              href={`tel:${site.contact.phone.replace(/\s+/g, "")}`}
            >
              {site.contact.phone}
            </a>
          </div>

        </div>

      </div>

    </div>


    <!-- ÉTAPES SUIVANTES -->
    <div class="essayer-followup">

      <h3 class="essayer-followup-title">
        Et après la première séance ?
      </h3>

      <div class="inscription-steps">

        <div class="inscription-step">
          <span class="inscription-step-number">1</span>
          <h4 class="inscription-step-title">Remplissez la fiche</h4>
          <p class="inscription-step-text">
            À télécharger ci-dessous, ou à demander
            directement sur place.
          </p>
        </div>

        <div class="inscription-step">
          <span class="inscription-step-number">2</span>
          <h4 class="inscription-step-title">Remettez-la à la salle</h4>
          <p class="inscription-step-text">
            Avec votre règlement, lors d’un entraînement.
          </p>
        </div>

      </div>

      <div class="inscription-panel">

        <div class="inscription-panel-content">

          <a
            class="inscription-download-button"
            href="/documents/fiche_inscription_ACTT_2026-2027.pdf"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span>↓&nbsp;&nbsp;Télécharger la fiche d'inscription 2026-2027</span>
          </a>

          <p class="inscription-download-note">
            PDF à signer · aussi disponible à la salle
          </p>

          <div class="inscription-separator" aria-hidden="true"></div>

          <div class="inscription-info-grid">

            <div class="inscription-info-item">
              <span class="inscription-info-label">Paiement</span>
              <span class="inscription-info-value">
                Chèque à la salle<br />
                ou virement (IBAN sur la fiche)
              </span>
            </div>

            <div class="inscription-info-item">
              <span class="inscription-info-label">Contact</span>
              <span class="inscription-info-value">
                <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
                <span class="inscription-info-sep"> · </span>
                <a href={`tel:${site.contact.phone.replace(/\s+/g, "")}`}>{site.contact.phone}</a>
              </span>
            </div>

          </div>

          <p class="inscription-hint">
            Vous ne pouvez pas venir un mardi ou un jeudi ?
            <a href={`mailto:${site.contact.email}`}>Écrivez-nous</a>
          </p>

        </div>

      </div>

    </div>

  </VisionOSSection>


  <!-- GALERIE -->
  <VisionOSSection
    id="galerie"
    eyebrow="GALERIE"
    title="L’ACTT en images"
    description="Quelques moments forts de la vie du club."
    align="center"
    spacing="sm"
  >
    <VisionOSGallery />
  </VisionOSSection>


  <div id="contact" aria-hidden="true"></div>

</PageLayout>


<style>

  :global(.vision-section-align-center) :global(.vision-section-title) {
    margin-inline: auto;
  }

  /* Titre de la section Première séance : équilibre des lignes
     pour éviter le mot orphelin ("réserver" seul). */
  :global(.vision-section[id="essayer"]) :global(.vision-section-title) {
    text-wrap: balance;
  }

  /* =======================================================
     LE CLUB
     ======================================================= */

  :global(.club-panel)::before,
  :global(.club-panel)::after {
    display: none !important;
    content: none !important;
  }

  .club-panel {
    border-top: 1px solid var(--vision-border) !important;
  }

  .club-panel-primary {
    border-top: 1px solid var(--vision-border) !important;
  }


  /* =======================================================
     ÉQUIPES
     ======================================================= */

  .equipes-grid {
    align-items: stretch;
  }


  /* =======================================================
     CALENDRIER ET RÉSULTATS
     ======================================================= */

  .calendrier-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    align-items: stretch;
    gap: 24px;
  }

  .calendrier-card {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: #ffffff;
    border: 1px solid rgba(6, 26, 58, 0.10);
    border-radius: 16px;
    box-shadow: 0 14px 34px rgba(6, 26, 58, 0.10);
  }

  .calendrier-card-accent {
    display: block;
    width: 100%;
    height: 4px;
    flex: 0 0 4px;
  }

  .calendrier-card-results .calendrier-card-accent {
    background: linear-gradient(90deg, #35a853 0%, #8bcf32 100%);
  }

  .calendrier-card-upcoming .calendrier-card-accent {
    background: linear-gradient(90deg, #00aeef 0%, #073b7a 100%);
  }

  .calendrier-card-header {
    padding: 22px 26px 18px;
    border-bottom: 1px solid rgba(6, 26, 58, 0.08);
  }

  .calendrier-card-eyebrow {
    display: block;
    margin-bottom: 6px;
    color: #45617f;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .calendrier-card-title {
    margin: 0;
    color: #061a3a;
    font-size: 1.3rem;
    font-weight: 800;
    letter-spacing: -0.01em;
  }

  .calendar-list {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
    flex: 1;
  }

  .calendar-item {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 16px 26px;
    border-bottom: 1px solid rgba(6, 26, 58, 0.06);
  }

  .calendar-item:last-child { border-bottom: none; }

  .calendar-item-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .calendar-item-datetime {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: #45617f;
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .calendar-item-date {
    color: #45617f;
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .calendar-item-time {
    color: #45617f;
    font-size: 0.82rem;
    font-weight: 600;
  }

  .calendar-item-match {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 6px;
    color: #061a3a;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.35;
  }

  .calendar-item-team,
  .calendar-item-opponent {
    color: #061a3a;
    font-weight: 600;
  }

  .calendar-item-vs {
    color: #45617f;
    font-weight: 500;
    font-size: 0.9rem;
  }

  .calendar-item-division {
    color: #45617f;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .calendar-item-location {
    display: inline-flex;
    align-items: center;
    padding: 4px 10px;
    border-radius: 999px;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    white-space: nowrap;
    text-decoration: none;
    transition: background-color 180ms ease, color 180ms ease;
  }

  .calendar-item-location-home {
    background: rgba(53, 168, 83, 0.14);
    color: #1f6b35;
  }

  .calendar-item-location-home:hover {
    background: rgba(53, 168, 83, 0.22);
    color: #1f6b35;
  }

  .calendar-item-location-away {
    background: rgba(0, 174, 239, 0.14);
    color: #073b7a;
  }

  .calendar-result-badge {
    display: inline-flex;
    align-items: center;
    padding: 4px 12px;
    border-radius: 999px;
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  .calendar-result-badge-victoire {
    background: rgba(53, 168, 83, 0.14);
    color: #1f6b35;
  }

  .calendar-result-badge-defaite,
  .calendar-result-badge-nul {
    background: rgba(6, 26, 58, 0.07);
    color: #45617f;
  }

  .calendar-item-result {
    gap: 4px;
    padding: 14px 26px;
  }

  .calendar-item-result .calendar-item-match { font-size: 0.92rem; }


  /* =======================================================
     PREMIÈRE SÉANCE
     ======================================================= */

  /* Le bloc entier est centré dans la page (max-width + auto),
     mais le texte interne reste aligné à gauche. */
  .essayer-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: start;

    max-width: 900px;
    margin-inline: auto;

    text-align: left;
  }

  .essayer-info {
    display: flex;
    flex-direction: column;
    gap: 32px;

    text-align: left;
  }

  .essayer-info-list {
    display: flex;
    flex-direction: column;
    gap: 32px;
    margin: 0;
    padding: 0;

    text-align: left;
  }

  .essayer-info-item {
    display: flex;
    flex-direction: column;
    gap: 10px;

    text-align: left;
  }

  .essayer-info-label {
    color: #00aeef;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;

    text-align: left;
  }

  .essayer-info-value {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin: 0;
    color: #f8fafc;
    font-size: 1rem;
    line-height: 1.6;

    text-align: left;
  }

  .essayer-info-value strong {
    display: block;
    color: #f8fafc;
    font-size: 1.125rem;
    font-weight: 700;
    line-height: 1.3;
    margin-bottom: 4px;

    text-align: left;
  }

  .essayer-info-value span {
    display: block;
    color: rgba(248, 250, 252, 0.82);
    font-size: 1rem;
    line-height: 1.55;

    text-align: left;
  }

  .essayer-visual {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  :global(.essayer-map) {
    min-height: 320px;
  }

  .essayer-actions {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .essayer-itinerary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 56px;
    padding: 0 28px;
    border-radius: 999px;
    background: #35a853;
    color: #061a3a;
    font-size: 0.98rem;
