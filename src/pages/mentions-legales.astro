---
/**
 * =========================================================
 * ACTT — MENTIONS LÉGALES
 * =========================================================
 *
 * Conformes à la loi n° 2004-575 du 21 juin 2004 (LCEN),
 * article 6-III.
 *
 * Informations issues de l'attestation SIRENE du 26/01/2025.
 */

import PageLayout from "../layouts/PageLayout.astro";
import { site } from "../config/site";

// Date de dernière mise à jour — à modifier manuellement.
const LAST_UPDATE = "5 octobre 2026";
---

<PageLayout
  title="Mentions légales"
  description="Mentions légales du site de l'ACTT — Association Camphinoise de Tennis de Table."
>

  <section class="legal-page">

    <div class="legal-container">

      <header class="legal-header">

        <span class="legal-eyebrow">
          Informations légales
        </span>

        <h1 class="legal-title">
          Mentions légales
        </h1>

        <p class="legal-description">
          Conformément à la loi n° 2004-575 du 21 juin 2004 pour la confiance
          dans l'économie numérique (LCEN), les informations suivantes sont
          portées à la connaissance des utilisateurs du site.
        </p>

      </header>


      <!-- =============================================
           1. ÉDITEUR DU SITE
           ============================================= -->

      <article class="legal-block">

        <h2>1. Éditeur du site</h2>

        <p>
          <strong>Dénomination&nbsp;: </strong>
          Association Camphinoise de Tennis de Table (ACTT)
        </p>

        <p>
          <strong>Forme juridique&nbsp;: </strong>
          Association déclarée, régie par la loi du 1<sup>er</sup> juillet 1901
        </p>

        <p>
          <strong>Siège social&nbsp;: </strong><br />
          Mairie de Camphin-en-Carembault<br />
          11 Rue du Général de Gaulle<br />
          59133 Camphin-en-Carembault<br />
          France
        </p>

        <p>
          <strong>SIREN&nbsp;: </strong>
          893 944 298
        </p>

        <p>
          <strong>SIRET (siège)&nbsp;: </strong>
          893 944 298 00015
        </p>

        <p>
          <strong>Numéro RNA&nbsp;: </strong>
          W595036986
        </p>

        <p>
          <strong>Code APE&nbsp;: </strong>
          93.12Z — Activités de clubs de sports
        </p>

        <p>
          <strong>Date de création&nbsp;: </strong>
          10 juin 2020
        </p>

        <p>
          <strong>Adresse électronique&nbsp;: </strong>
          <a href={`mailto:${site.contact.email}`}>
            {site.contact.email}
          </a>
        </p>

        <p>
          <strong>Téléphone&nbsp;: </strong>
          {site.contact.phone}
        </p>

        <p>
          <strong>Lieu d'activité&nbsp;: </strong><br />
          Salle omnisports<br />
          7 Rue du Joncquoy<br />
          59133 Camphin-en-Carembault
        </p>

      </article>


      <!-- =============================================
           2. DIRECTEUR DE LA PUBLICATION
           ============================================= -->

      <article class="legal-block">

        <h2>2. Directeur de la publication</h2>

        <p>
          <strong>Nom&nbsp;: </strong>
          Éric Rambure
        </p>

        <p>
          <strong>Qualité&nbsp;: </strong>
          Président de l'Association Camphinoise de Tennis de Table
        </p>

        <p>
          <strong>Contact&nbsp;: </strong>
          <a href={`mailto:${site.contact.email}`}>
            {site.contact.email}
          </a>
        </p>

      </article>


      <!-- =============================================
           3. HÉBERGEUR
           ============================================= -->

      <article class="legal-block">

        <h2>3. Hébergement</h2>

        <p>
          Le site est hébergé par&nbsp;:
        </p>

        <p>
          <strong>Cloudflare, Inc.</strong><br />
          101 Townsend Street<br />
          San Francisco, CA 94107<br />
          États-Unis
        </p>

        <p>
          <strong>Site internet&nbsp;: </strong>
          <a
            href="https://www.cloudflare.com"
            target="_blank"
            rel="noopener noreferrer"
          >
            www.cloudflare.com
          </a>
        </p>

        <p>
          <strong>Contact&nbsp;: </strong>
          <a
            href="https://www.cloudflare.com/transparency/"
            target="_blank"
            rel="noopener noreferrer"
          >
            Formulaire de contact Cloudflare
          </a>
        </p>

      </article>


      <!-- =============================================
           4. PROPRIÉTÉ INTELLECTUELLE
           ============================================= -->

      <article class="legal-block">

        <h2>4. Propriété intellectuelle</h2>

        <p>
          L'ensemble des contenus présents sur ce site (textes, images, logos,
          photographies, illustrations, structure, code source) est la propriété
          exclusive de l'Association Camphinoise de Tennis de Table, sauf mention
