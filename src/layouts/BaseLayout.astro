---
/**
 * =========================================================
 * VISIONOS — BASE LAYOUT
 * =========================================================
 */

import { site } from "../config/site";
import { theme } from "../config/theme";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noIndex?: boolean;
}

const {
  title = site.seo.title,
  description = site.seo.description,
  image = site.seo.image,
  noIndex = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, site.url);
const socialImage = new URL(image, site.url);

const themeName = theme.active;

const fullTitle =
  title === site.seo.title
    ? title
    : `${title} — ${site.name}`;

// Nom complet du club pour OG site_name
const fullSiteName =
  "ACTT — Camphin-en-Carembault Tennis de Table";

// ---------------------------------------------------------
// SCHEMA.ORG — SPORTS CLUB (enrichi)
// ---------------------------------------------------------

const structuredData = {
  "@context": "https://schema.org",
  "@type": "SportsClub",
  "@id": `${site.url}/#club`,
  name: "ACTT — Association Camphinoise de Tennis de Table",
  alternateName: "ACTT",
  description: site.seo.description,
  url: site.url,
  logo: new URL(site.assets.logo, site.url).href,
  image: socialImage.href,
  email: site.contact.email,
  telephone:
    "+33" +
    site.contact.phone.replace(/\s/g, "").replace(/^0/, ""),
  sport: "Tennis de table",
  foundingDate: "2020-06-10",

  address: {
    "@type": "PostalAddress",
    streetAddress: site.contact.address,
    postalCode: site.contact.postalCode,
    addressLocality: site.contact.city,
    addressRegion: "Hauts-de-France",
    addressCountry: "FR",
  },

  areaServed: {
    "@type": "City",
    name: "Camphin-en-Carembault",
  },

  memberOf: {
    "@type": "Organization",
    name: "Fédération Française de Tennis de Table",
  },

  openingHoursSpecification: [
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: ["Tuesday", "Thursday"],
      opens: "18:00",
      closes: "21:00",
    },
  ],
};
---

<!doctype html>
<html lang="fr" data-theme={themeName}>

  <head>

    <!-- =================================================
         BASE
         ================================================= -->

    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <meta
      name="theme-color"
      content="#061a3a"
    />

    <!-- =================================================
         PERFORMANCE — PRECONNECT
         ================================================= -->

    <link rel="preconnect" href="https://www.google.com" />

    <!-- =================================================
         GOOGLE SEARCH CONSOLE — VÉRIFICATION
         ================================================= -->

    <meta
      name="google-site-verification"
      content="-7_qeJAAxpTzzjEkcBLpWnTHrax5WxJUNxlLRbIJ7T0"
    />

    <!-- =================================================
         SEO PRIMAIRE
         ================================================= -->

    <title>{fullTitle}</title>

    <meta
      name="description"
      content={description}
    />

    <link
      rel="canonical"
      href={canonicalURL}
    />

    <link
      rel="alternate"
      hreflang="fr"
      href={canonicalURL}
    />

    <!-- =================================================
         ROBOTS
         ================================================= -->

    {
      noIndex ? (
        <meta name="robots" content="noindex, nofollow" />
      ) : (
        <meta
          name="robots"
          content="index, follow, max-image-preview:large, max-snippet:-1"
        />
      )
    }

    <!-- =================================================
         FAVICON — PACK MULTI-FORMATS
         ================================================= -->

    <link
      rel="icon"
      type="image/png"
      href="/favicon-96x96.png"
      sizes="96x96"
    />

    <link
      rel="icon"
      type="image/svg+xml"
      href="/favicon.svg"
    />

    <link
      rel="shortcut icon"
      href="/favicon.ico"
    />

    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/apple-touch-icon.png"
    />

    <link
      rel="manifest"
      href="/site.webmanifest"
    />

    <!-- =================================================
         OPEN GRAPH
         ================================================= -->

    <meta property="og:type" content="website" />

    <meta
      property="og:site_name"
      content={fullSiteName}
    />

    <meta property="og:locale" content="fr_FR" />

    <meta
      property="og:title"
      content={fullTitle}
    />

    <meta
      property="og:description"
      content={description}
    />

    <meta
      property="og:url"
      content={canonicalURL}
    />

    <meta
      property="og:image"
      content={socialImage}
    />

    <meta
      property="og:image:width"
      content="1200"
    />

    <meta
      property="og:image:height"
      content="630"
    />

    <meta
      property="og:image:type"
      content="image/jpeg"
    />

    <meta
      property="og:image:alt"
      content={fullSiteName}
    />

    <!-- =================================================
         TWITTER / X
         ================================================= -->

    <meta
      name="twitter:card"
      content={site.seo.twitterCard}
    />

    <meta
      name="twitter:title"
      content={fullTitle}
    />

    <meta
      name="twitter:description"
      content={description}
    />

    <meta
      name="twitter:image"
      content={socialImage}
    />

    <meta
      name="twitter:image:alt"
      content={fullSiteName}
    />

    <!-- =================================================
         SCHEMA.ORG — SPORTS CLUB
         ================================================= -->

    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    />

    <!-- =================================================
         PAGE-SPECIFIC HEAD
         ================================================= -->

    <slot name="head" />

  </head>

  <body>

    <slot />

    <!-- =================================================
         PROGRESSIVE ENHANCEMENT
         ================================================= -->

    <script>
      import "../scripts/visionos-effects.js";
    </script>

  </body>

</html>