---
/**
 * =========================================================
 * ACTT — NEWS CARD (HALLOWEEN EDITION)
 * =========================================================
 */

import VisionOSBadge from "./VisionOSBadge.astro";
import type { NewsItem } from "../data/news";

interface Props {
  item: NewsItem;
}

const { item } = Astro.props;

const imageList: string[] = item.images && item.images.length > 0 
  ? item.images 
  : (item.image ? [item.image] : []);

const isHalloween = item.theme === "halloween";
---

<article class:list={["news-card", { "news-card--halloween": isHalloween }]}>
  <span class="news-card-accent" aria-hidden="true"></span>

  {imageList.length === 1 && (
    <div class="news-card-image">
      <img
        src={imageList[0]}
        alt={item.title}
        width="800"
        height="450"
        loading="lazy"
        decoding="async"
      />
    </div>
  )}

  {imageList.length > 1 && (
    <div class="news-card-gallery" data-count={imageList.length}>
      {isHalloween && (
        <div class="bat-flight-zone" aria-hidden="true">
          <span class="bat-fly bat-fly--1">🦇</span>
          <span class="bat-fly bat-fly--2">🦇</span>
          <span class="bat-fly bat-fly--3">🦇</span>
        </div>
      )}
      {imageList.map((imgSrc, index) => (
        <div class="news-card-gallery-item">
          <img
            src={imgSrc}
            alt={`${item.title} - photo ${index + 1}`}
            loading="lazy"
            decoding="async"
          />
        </div>
      ))}
    </div>
  )}

  <div class="news-card-content">
    <header class="news-card-header">
      <time datetime={item.date} class="news-card-date">
        {item.dateLabel}
      </time>

      <div class="badge-wrapper">
        {item.category && (
          <VisionOSBadge label={item.category} variant={isHalloween ? "warning" : "primary"} />
        )}
        {isHalloween && (
          <span class="halloween-decor" aria-hidden="true">
            <span class="ghost">👻</span>
            <span class="bat">🦇</span>
          </span>
        )}
      </div>
    </header>

    <h3 class="news-card-title">
      {item.title}
    </h3>

    <div class="news-card-body">
      {item.body.map((paragraph) => <p>{paragraph}</p>)}
    </div>

    {item.author && (
      <p class="news-card-author">
        — {item.author}
      </p>
    )}
  </div>
</article>

<style>
  .news-card {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: #ffffff;
    border: 1px solid rgba(6, 26, 58, 0.10);
    border-radius: 16px;
    box-shadow: 0 14px 34px rgba(6, 26, 58, 0.10);
    content-visibility: auto;
    contain-intrinsic-size: 500px;
    transition:
      transform var(--vision-duration-normal, 0.3s) var(--vision-ease-smooth, ease),
      box-shadow var(--vision-duration-normal, 0.3s) var(--vision-ease-smooth, ease),
      border-color var(--vision-duration-normal, 0.3s) var(--vision-ease-smooth, ease);
  }

  /* =====================================================
     ANIMATIONS HALLOWEEN
     ===================================================== */

  @keyframes halloween-glow {
    0%, 100% {
      box-shadow: 0 14px 34px rgba(249, 115, 22, 0.15), 0 0 10px rgba(249, 115, 22, 0.1);
      border-color: rgba(249, 115, 22, 0.35);
    }
    50% {
      box-shadow: 0 18px 40px rgba(234, 88, 12, 0.3), 0 0 25px rgba(245, 158, 11, 0.25);
      border-color: rgba(249, 115, 22, 0.7);
    }
  }

  @keyframes float-ghost {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50% { transform: translateY(-5px) rotate(6deg); }
  }

  @keyframes flutter-bat {
    0%, 100% { transform: translateY(0) scale(1); }
    50% { transform: translateY(-3px) scale(1.15) rotate(-8deg); }
  }

  @keyframes spider-descend {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(8px); }
  }

  @keyframes bat-cross {
    0% {
      left: -20%;
      opacity: 0;
      transform: translateY(0) rotate(0);
    }
    10% { opacity: 0.9; }
    50% {
      transform: translateY(-12px) rotate(8deg);
    }
    90% { opacity: 0.9; }
    100% {
      left: 110%;
      opacity: 0;
      transform: translateY(0) rotate(0);
    }
  }

  .news-card--halloween {
    animation: halloween-glow 3.5s ease-in-out infinite;
  }

  /* Toile d'araignée décorative */
  .news-card--halloween::before {
    content: "";
    position: absolute;
    top: 0;
    right: 0;
    width: 120px;
    height: 120px;
    background-image:
      linear-gradient(0deg, transparent 49%, rgba(249, 115, 22, 0.35) 49.5%, rgba(249, 115, 22, 0.35) 50.5%, transparent 51%),
      linear-gradient(22.5deg, transparent 49%, rgba(249, 115, 22, 0.35) 49.5%, rgba(249, 115, 22, 0.35) 50.5%, transparent 51%),
      linear-gradient(45deg, transparent 49%, rgba(249, 115, 22, 0.35) 49.5%, rgba(249, 115, 22, 0.35) 50.5%, transparent 51%),
      linear-gradient(67.5deg, transparent 49%, rgba(249, 115, 22, 0.35) 49.5%, rgba(249, 115, 22, 0.35) 50.5%, transparent 51%),
      linear-gradient(90deg, transparent 49%, rgba(249, 115, 22, 0.35) 49.5%, rgba(249, 115, 22, 0.35) 50.5%, transparent 51%),
      radial-gradient(circle at top right, transparent 25%, rgba(249, 115, 22, 0.35) 25.3%, transparent 25.8%),
      radial-gradient(circle at top right, transparent 50%, rgba(249, 115, 22, 0.35) 50.3%, transparent 50.8%),
      radial-gradient(circle at top right, transparent 75%, rgba(249, 115, 22, 0.35) 75.3%, transparent 75.8%);
    background-size: 100% 100%;
    background-position: top right;
    background-repeat: no-repeat;
    pointer-events: none;
    opacity: 0.8;
    z-index: 5;
  }

  .news-card-accent {
    display: block;
    width: 100%;
    height: 4px;
    flex: 0 0 4px;
    background: linear-gradient(90deg, #00aeef 0%, #35a853 100%);
  }

  .news-card--halloween .news-card-accent {
    background: linear-gradient(90deg, #ea580c 0%, #f59e0b 50%, #7c3aed 100%);
  }

  .badge-wrapper {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .halloween-decor {
    position: relative;
    display: inline-flex;
    gap: 6px;
    font-size: 1.15rem;
    line-height: 1;
    user-select: none;
  }

  .ghost {
    display: inline-block;
    animation: float-ghost 2.5s ease-in-out infinite;
  }

  .bat {
    display: inline-block;
    animation: flutter-bat 1.8s ease-in-out infinite;
  }

  .news-card--halloween .halloween-decor::before {
    content: "🕷️";
    position: absolute;
    top: -24px;
    left: 50%;
    translate: -50% 0;
    font-size: 1.5rem;
    animation: spider-descend 2s ease-in-out infinite;
    filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.3));
    pointer-events: none;
    z-index: 10;
  }

  @media (hover: hover) and (pointer: fine) {
    .news-card:hover {
      transform: translateY(-3px);
      box-shadow: 0 20px 40px rgba(6, 26, 58, 0.14);
    }

    .news-card--halloween:hover {
      animation-play-state: paused;
      transform: translateY(-6px) scale(1.005);
      box-shadow: 0 24px 48px rgba(234, 88, 12, 0.35), 0 0 35px rgba(245, 158, 11, 0.35);
      border-color: rgba(249, 115, 22, 0.9);
    }
  }

  /* Images standards */
  .news-card-image {
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #e8eef4;
  }

  .news-card-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Galerie multi-images & chauves-souris */
  .news-card-gallery {
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
    padding: 12px 12px 0 12px;
    background: #0b1329;
    overflow: hidden;
  }

  .bat-flight-zone {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 10;
    overflow: hidden;
  }

  .bat-fly {
    position: absolute;
    pointer-events: none;
    opacity: 0;
    filter: drop-shadow(0 3px 6px rgba(0, 0, 0, 0.6)) drop-shadow(0 0 5px rgba(245, 158, 11, 0.5));
    line-height: 1;
  }

  .bat-fly--1 {
    top: 15%;
    font-size: 2.4rem;
    animation: bat-cross 6s linear infinite;
    animation-delay: 0s;
  }

  .bat-fly--2 {
    top: 45%;
    font-size: 2rem;
    animation: bat-cross 7.5s linear infinite;
    animation-delay: 2.2s;
  }

  .bat-fly--3 {
    top: 70%;
    font-size: 2.8rem;
    animation: bat-cross 6.5s linear infinite;
    animation-delay: 4.5s;
  }

  .news-card-gallery-item {
    position: relative;
    z-index: 1;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 10px;
    background: #1e293b;
  }

  /* Nombre impair d'images (ex: 3) -> la dernière s'étend sur 2 colonnes */
  .news-card-gallery[data-count="3"] .news-card-gallery-item:last-child {
    grid-column: span 2;
    aspect-ratio: 16 / 9;
  }

  .news-card-gallery-item img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.45s ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .news-card-gallery-item:hover img {
      transform: scale(1.05);
    }
  }

  .news-card-content {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 28px 32px 30px;
  }

  .news-card-header {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
  }

  .news-card-date {
    color: #45617f;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .news-card-title {
    margin: 0;
    color: #061a3a;
    font-size: clamp(1.3rem, 2.4vw, 1.65rem);
    font-weight: 900;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .news-card-body {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .news-card-body p {
    margin: 0;
    color: #17345c;
    font-size: 1rem;
    line-height: 1.65;
  }

  .news-card-author {
    margin: 4px 0 0;
    color: #45617f;
    font-size: 0.9rem;
    font-style: italic;
    font-weight: 600;
    text-align: right;
  }

  @media (max-width: 767px) {
    .news-card-gallery {
      grid-template-columns: 1fr;
      padding: 8px 8px 0 8px;
    }

    .news-card-gallery[data-count="3"] .news-card-gallery-item:last-child {
      grid-column: span 1;
      aspect-ratio: 16 / 10;
    }

    .news-card-gallery-item {
      aspect-ratio: 16 / 10;
    }

    .bat-fly--1 { font-size: 1.8rem; }
    .bat-fly--2 { font-size: 1.5rem; }
    .bat-fly--3 { font-size: 2rem; }

    .news-card-content {
      padding: 22px 22px 24px;
    }

    .news-card-title {
      font-size: 1.2rem;
    }

    .news-card-body p {
      font-size: 0.95rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .news-card,
    .news-card--halloween,
    .ghost,
    .bat,
    .bat-fly {
      animation: none !important;
      transition: none !important;
    }

    .bat-flight-zone,
    .news-card--halloween .halloween-decor::before {
      display: none !important;
    }

    .news-card:hover,
    .news-card--halloween:hover {
      transform: none;
    }

    .news-card-gallery-item img {
      transition: none;
    }
  }
</style>